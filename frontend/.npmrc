# Never run install scripts (preinstall/install/postinstall) of npm packages. They run on every `npm ci` or
# `npm install` with our permissions, which is how malicious releases usually strike. Today no installed package
# needs one (only the macOS-only fsevents declares one). `npm run <script>` still runs our own scripts.
# See docs/adr/0006-dependency-supply-chain.md.
ignore-scripts=true
